{
  "ConnectionStrings": {
    "DefaultConnection": "<PostgreSQL connection string>"
  },
  "Firebase": {
    "CredentialsPath": "<absolute or container path to Firebase Admin JSON>"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },
  "RestCountries": {
    "ApiKey": "<REST Countries API key>"
  },
  "Gemini": {
    "ApiKey": "<Gemini API key>",
    "Model": "gemini-3.5-flash-lite",
    "TimeoutSeconds": 45,
    "MaxAttempts": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
